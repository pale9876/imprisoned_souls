[resource]
script = ExtResource("1_foul2")
cooldown = 31
name = &"병목치기"
icon = ExtResource("1_4qal3")
description = "날붙이 적에게 피해를 입힐 때마다 표식을 남긴다. 한 번의 타격마다 3 데미지가 적립되고 5초간 유지된다. 스킬 발동 시, 적립된 데미지를 입히고 다음과 같은 효과가 발동된다.

3 스택 이상 발동 시, 적이 15프레임의 짧은 경직을 받는다.

8스택 이상 발동시, 적이 공중에 높이 띄워진다.

11 스택 이상 발동 시, 슈퍼아머 상태를 무시하고, 그 자리에 쓰러진다."
metadata/_custom_type_script = "uid://dvl7esb756qhi"
