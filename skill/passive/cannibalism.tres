[resource]
script = ExtResource("1_hmut3")
perk_description = "비 전투 상태일 때, 죽은 적 유닛의 시체를 섭취할 수 있게 된다. 전투 상태에 돌입 시 섭취한 객체 하나에 6% 데미지가 적립되고, 체력 27%가 회복된다.
비 전투 상태가 되면 모든 효과가 제거된다."
name = &"동족 포식"
