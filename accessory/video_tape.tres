script = ExtResource("1_b44qw")
name = &"홈 비디오 테이프"
description = "'노아' 의 이름표를 붙힌 캠코더용 녹화 테이프이다. 기밀 테이프의 재생을 막는 구조가 존재하지 않는 일반적인 테이프인 것 같다."
